# Placeholder inventory only. Replace in ignored .env.local or Vercel settings.
# Never prefix server secrets with NEXT_PUBLIC_.
APP_BASE_URL=<application-origin>
DATABASE_URL=<managed-postgresql-connection-string>
SESSION_SECRET=<random-session-signing-secret>
PAYMENT_MODE=<mock-or-live>
LIVE_PAYMENTS_ENABLED=<true-or-false>
TAPSYS_BASE_URL=<provider-approved-api-origin>
TAPSYS_AGGREGATOR_CODE=<aggregator-code>
TAPSYS_CLIENT_SECRET=<client-secret>
TAPSYS_MERCHANT_ID=<merchant-id>
TAPSYS_TILL_CODE=<till-code>
TAPSYS_TERMINAL_ID=<terminal-id>
TAPSYS_TIMESTAMP_TIMEZONE=<provider-confirmed-timezone>
QR_TTL_SECONDS=<default-120>
PAYMENT_MIN_PAISA=<default-100>
PAYMENT_MAX_PAISA=<default-10000>
INITIATION_RATE_LIMIT_PER_MINUTE=<default-5>
# Callback verification configuration will be named after Tapsys confirms its scheme.
# Do not invent a webhook secret or assume HMAC support.
