# Local development only. Supply private values in ignored .env.local.
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:<port>/raastdemo
SESSION_SECRET=<random-secret-at-least-32-characters>
APP_BASE_URL=http://localhost:3100
APP_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
COOKIE_SECURE=false
PAYMENT_MODE=mock
LIVE_PAYMENTS_ENABLED=false
# Compose settings belong in /backupfiles/raastdemo/.env on the VM.
# APP_IMAGE=raastdemo:v0.1.0-<commit>
# DATA_DIR=/backupfiles/raastdemo/data
# DB_PASSWORD=<random-hex-secret>
